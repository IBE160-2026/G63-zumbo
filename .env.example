# Kopier denne fila til .env og fyll inn verdiene. .env skal aldri sjekkes inn i git.
# Uten nøkkel virker alt unntatt KI-forklaringen.
ANTHROPIC_API_KEY=
# Valgfritt. Tom verdi betyr standardmodellen fra arkitekturen.
ANTHROPIC_MODEL=
# Valgfritt. Mappe for mellomlagrede svar fra FHI. En relativ sti regnes fra reporoten.
# Tom verdi betyr .cache/ i reporoten (på Vercel /tmp/fhi-helsedata-cache).
CACHE_DIR=
